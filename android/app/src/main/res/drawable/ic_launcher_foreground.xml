<?xml version="1.0" encoding="utf-8"?>
<!-- La F de FoodTruckOS, dibujada como vector en vez de exportada como PNG:
     así sale nítida en cualquier densidad de pantalla y no hay que mantener
     cinco copias del mismo archivo.
     El lienzo del icono adaptativo mide 108dp pero solo los 72dp centrales
     están garantizados: el launcher recorta el resto según su forma. La letra
     va de 37 a 71 en horizontal y de 32 a 76 en vertical, holgadamente dentro
     de esa zona segura. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M37,32 H71 V42 H49 V50 H67 V60 H49 V76 H37 Z" />
</vector>
