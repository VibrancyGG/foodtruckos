<?xml version="1.0" encoding="utf-8"?>
<!-- La P de Pavessa, dibujada como vector en vez de exportada como PNG: así
     sale nítida en cualquier densidad de pantalla y no hay que mantener cinco
     copias del mismo archivo.
     El lienzo del icono adaptativo mide 108dp pero solo los 72dp centrales
     están garantizados: el launcher recorta el resto según su forma. La letra
     va de 35 a 72 en horizontal y de 31 a 77 en vertical, dentro de esa zona.
     El asta es más gruesa que las barras horizontales (13 contra 9): en una P
     con barras del mismo grosor que el asta, el contador se cierra y la letra
     se lee como un cuadrado. El hueco de la panza se hace con evenOdd. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M35,31 H72 V62 H48 V77 H35 Z M48,40 H61 V53 H48 Z" />
</vector>
